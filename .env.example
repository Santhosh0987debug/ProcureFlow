# ProcureFlow API
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_VERSION=0.2.0

# PostgreSQL
# Use a dedicated database for integration tests. Tests truncate this schema.
DATABASE_URL=postgresql://procureflow:replace-me@localhost:5432/procureflow?schema=public
TEST_DATABASE_URL=postgresql://procureflow:replace-me@localhost:5432/procureflow_test?schema=public

# Authentication
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=procureflow-api
JWT_AUDIENCE=procureflow-web
SESSION_TTL_HOURS=168
COOKIE_NAME=procureflow_session
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
# TRUST_PROXY=0

# Web (optional — Vite proxies /api to the server by default)
# VITE_API_PROXY_TARGET=http://localhost:4000
