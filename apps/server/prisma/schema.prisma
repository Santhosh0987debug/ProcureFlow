// ProcureFlow database architecture.
//
// Design principles:
// - Every business record is scoped to a workspace for tenant isolation.
// - Monetary values use fixed-precision decimals; floating point is never used.
// - Status vocabulary mirrors the shared contracts in @procureflow/shared.
// - Approval and audit structures are ready for Phase 3 state machines without
//   implementing workflow behaviour here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  EUR
  GBP
  INR
}

enum Priority {
  low
  medium
  high
  urgent
}

enum RequestStatus {
  draft
  submitted
  pending_approval
  changes_requested
  approved
  rejected
  cancelled
}

enum ApprovalCycleStatus {
  pending
  approved
  rejected
  changes_requested
  cancelled
}

enum ApprovalStepStatus {
  pending
  approved
  rejected
  changes_requested
  cancelled
  skipped
}

/// Parallel levels can require every assignee to approve or only one.
enum ApprovalLevelRule {
  all_required
  any_one
}

enum ApproverAssignmentType {
  member
  role
}

enum PurchaseOrderStatus {
  draft
  issued
  acknowledged
  partially_delivered
  delivered
  cancelled
}

enum DeliveryStatus {
  scheduled
  in_transit
  delivered
  delayed
  cancelled
}

enum VendorStatus {
  active
  onboarding
  inactive
  suspended
}

enum ProcurementCategory {
  information_technology
  facilities
  professional_services
  marketing
  operations
  logistics
}

enum QuotationStatus {
  draft
  submitted
  selected
  rejected
  expired
}

/// Workspace roles are always resolved from the member record, never from the
/// global user. The lower-case values are the stable database representation.
enum WorkspaceRole {
  owner
  admin
  procurement_manager
  requester
  approver
  viewer
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(80)
  lastName     String    @map("last_name") @db.VarChar(80)
  jobTitle     String?   @map("job_title") @db.VarChar(120)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships               WorkspaceMember[]
  suspendedMemberships      WorkspaceMember[]     @relation("MembershipSuspender")
  createdWorkspaces         Workspace[]           @relation("WorkspaceCreator")
  requestedPurchaseRequests PurchaseRequest[]     @relation("PurchaseRequestRequester")
  deletedPurchaseRequests   PurchaseRequest[]     @relation("PurchaseRequestDeleter")
  approvalSteps             ApprovalStep[]        @relation("ApprovalStepApprover")
  decidedApprovalSteps      ApprovalStep[]        @relation("ApprovalStepDecider")
  requestedApprovals        Approval[]           @relation("ApprovalRequester")
  createdApprovalWorkflows  ApprovalWorkflow[]    @relation("ApprovalWorkflowCreator")
  updatedApprovalWorkflows  ApprovalWorkflow[]    @relation("ApprovalWorkflowUpdater")
  createdPurchaseOrders     PurchaseOrder[]       @relation("PurchaseOrderCreator")
  receivedDeliveries        Delivery[]            @relation("DeliveryReceiver")
  sentInvitations           WorkspaceInvitation[] @relation("InvitationSender")
  acceptedInvitations       WorkspaceInvitation[] @relation("InvitationAcceptor")
  auditLogs                 AuditLog[]            @relation("AuditActor")

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.Text
  currency    Currency @default(USD)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User                  @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  vendors           Vendor[]
  purchaseRequests  PurchaseRequest[]
  approvals         Approval[]
  approvalWorkflows ApprovalWorkflow[]
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]
  deliveries       Delivery[]
  auditLogs        AuditLog[]

  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceMember {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  role          WorkspaceRole    @default(viewer)
  status        MembershipStatus @default(active)
  suspendedAt   DateTime?        @map("suspended_at") @db.Timestamptz(3)
  suspendedById String?          @map("suspended_by_id") @db.Uuid
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  suspendedBy       User?                      @relation("MembershipSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)
  workflowApprovers ApprovalWorkflowApprover[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@index([workspaceId, status, role])
  @@map("workspace_members")
}

/// Invitation tokens are only ever stored as SHA-256 hashes. `activeKey` is a
/// nullable unique value that prevents more than one pending invitation for the
/// same workspace and email, while still allowing a new invitation after the
/// previous one is accepted, revoked, or expired.
model WorkspaceInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  email        String           @db.VarChar(254)
  role         WorkspaceRole
  tokenHash    String           @unique @map("token_hash") @db.VarChar(64)
  status       InvitationStatus @default(pending)
  activeKey    String?          @unique @map("active_key") @db.VarChar(320)
  invitedById  String           @map("invited_by_id") @db.Uuid
  acceptedById String?          @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([email, status])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("workspace_invitations")
}

model Vendor {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  name         String              @db.VarChar(160)
  code         String              @db.VarChar(40)
  category     ProcurementCategory
  status       VendorStatus        @default(onboarding)
  contactName  String?             @map("contact_name") @db.VarChar(120)
  email        String?             @db.VarChar(254)
  phone        String?             @db.VarChar(40)
  website      String?             @db.VarChar(300)
  addressLine1 String?             @map("address_line1") @db.VarChar(180)
  addressLine2 String?             @map("address_line2") @db.VarChar(180)
  city         String?             @db.VarChar(100)
  region       String?             @db.VarChar(100)
  postalCode   String?             @map("postal_code") @db.VarChar(30)
  country      String?             @db.VarChar(100)
  taxId        String?             @map("tax_id") @db.VarChar(60)
  paymentTerms String?             @map("payment_terms") @db.VarChar(120)
  notes        String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, name])
  @@map("vendors")
}

model PurchaseRequest {
  id            String              @id @default(uuid()) @db.Uuid
  workspaceId   String              @map("workspace_id") @db.Uuid
  requestNumber String              @map("request_number") @db.VarChar(40)
  title         String              @db.VarChar(180)
  description   String?             @db.Text
  notes         String?             @db.Text
  status        RequestStatus       @default(draft)
  priority      Priority            @default(medium)
  category      ProcurementCategory
  currency      Currency            @default(USD)
  totalAmount   Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  department    String?             @db.VarChar(120)
  neededBy      DateTime?           @map("needed_by") @db.Timestamptz(3)
  submittedAt   DateTime?           @map("submitted_at") @db.Timestamptz(3)
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(3)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById   String?             @map("deleted_by_id") @db.Uuid
  requestedById String              @map("requested_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy    User                  @relation("PurchaseRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  deletedBy      User?                 @relation("PurchaseRequestDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  items          PurchaseRequestItem[]
  approvals      Approval[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@unique([workspaceId, requestNumber])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, deletedAt, status, createdAt])
  @@index([workspaceId, deletedAt, requestedById])
  @@index([workspaceId, requestedById])
  @@index([requestedById])
  @@index([deletedById])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String               @id @default(uuid()) @db.Uuid
  purchaseRequestId String               @map("purchase_request_id") @db.Uuid
  description       String               @db.VarChar(300)
  quantity          Decimal              @db.Decimal(12, 2)
  unit              String               @default("unit") @db.VarChar(40)
  unitPrice         Decimal              @map("unit_price") @db.Decimal(14, 2)
  lineTotal         Decimal              @map("line_total") @db.Decimal(14, 2)
  category          ProcurementCategory?
  notes             String?              @db.Text
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  quotationItems  QuotationItem[]

  @@index([purchaseRequestId])
  @@map("purchase_request_items")
}

/// Reusable workflow configuration. Editing a workflow never rewrites an
/// existing approval cycle; cycles copy the configuration they were created
/// with into their own rows.
model ApprovalWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(false) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  currency    Currency @default(USD)
  minAmount   Decimal? @map("min_amount") @db.Decimal(14, 2)
  maxAmount   Decimal? @map("max_amount") @db.Decimal(14, 2)
  createdById String   @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                    @relation("ApprovalWorkflowCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?                   @relation("ApprovalWorkflowUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  levels    ApprovalWorkflowLevel[]
  approvals Approval[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, isDefault])
  @@index([workspaceId, currency, minAmount, maxAmount])
  @@index([createdById])
  @@index([updatedById])
  @@map("approval_workflows")
}

model ApprovalWorkflowLevel {
  id             String             @id @default(uuid()) @db.Uuid
  workflowId     String             @map("workflow_id") @db.Uuid
  levelOrder     Int                @map("level_order")
  name           String             @db.VarChar(140)
  completionRule ApprovalLevelRule  @default(all_required) @map("completion_rule")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  workflow  ApprovalWorkflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approvers ApprovalWorkflowApprover[]

  @@unique([workflowId, levelOrder])
  @@map("approval_workflow_levels")
}

model ApprovalWorkflowApprover {
  id             String                 @id @default(uuid()) @db.Uuid
  levelId        String                 @map("level_id") @db.Uuid
  assignmentType ApproverAssignmentType @map("assignment_type")
  memberId       String?                @map("member_id") @db.Uuid
  role           WorkspaceRole?
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  level  ApprovalWorkflowLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  member WorkspaceMember?      @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([levelId])
  @@index([memberId])
  @@map("approval_workflow_approvers")
}

/// One approval cycle per submission/resubmission. Historical cycles remain
/// intact when a request is resubmitted after changes are requested.
model Approval {
  id                  String              @id @default(uuid()) @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  purchaseRequestId   String              @map("purchase_request_id") @db.Uuid
  workflowId          String?             @map("workflow_id") @db.Uuid
  workflowName        String?             @map("workflow_name") @db.VarChar(120)
  workflowDescription String?             @map("workflow_description") @db.Text
  cycleNumber         Int                 @default(1) @map("cycle_number")
  status              ApprovalCycleStatus @default(pending)
  currentLevel        Int                 @default(1) @map("current_level")
  levelCount          Int                 @default(1) @map("level_count")
  requestedById       String?             @map("requested_by_id") @db.Uuid
  requestedAt         DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(3)
  expiresAt           DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  workflow        ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  requestedBy     User?            @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  steps           ApprovalStep[]

  @@unique([purchaseRequestId, cycleNumber])
  @@index([workspaceId, status, requestedAt])
  @@index([purchaseRequestId, status])
  @@index([requestedById])
  @@map("approvals")
}

/// Step rows are the immutable decision record for a cycle. `isActive` marks
/// the current sequential level; only active, pending steps can be decided.
model ApprovalStep {
  id             String                 @id @default(uuid()) @db.Uuid
  approvalId     String                 @map("approval_id") @db.Uuid
  levelOrder     Int                    @map("level_order")
  stepOrder      Int                    @map("step_order")
  name           String                 @db.VarChar(140)
  levelRule      ApprovalLevelRule      @map("level_rule")
  assignmentType ApproverAssignmentType @map("assignment_type")
  assignedRole   WorkspaceRole?         @map("assigned_role")
  approverId     String?                @map("approver_id") @db.Uuid
  decidedById    String?                @map("decided_by_id") @db.Uuid
  status         ApprovalStepStatus     @default(pending)
  isActive       Boolean                @default(false) @map("is_active")
  decisionNote   String?                @map("decision_note") @db.Text
  decidedAt      DateTime?              @map("decided_at") @db.Timestamptz(3)
  cancelledAt    DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  approval  Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approver  User?    @relation("ApprovalStepApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedBy User?    @relation("ApprovalStepDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([approvalId, stepOrder])
  @@index([approverId, status])
  @@index([approvalId, levelOrder, isActive])
  @@index([decidedById])
  @@map("approval_steps")
}

model Quotation {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  purchaseRequestId String          @map("purchase_request_id") @db.Uuid
  vendorId          String          @map("vendor_id") @db.Uuid
  quotationNumber   String          @map("quotation_number") @db.VarChar(40)
  status            QuotationStatus @default(draft)
  currency          Currency        @default(USD)
  subtotal          Decimal         @db.Decimal(14, 2)
  taxAmount         Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount       Decimal         @map("total_amount") @db.Decimal(14, 2)
  validUntil        DateTime?       @map("valid_until") @db.Timestamptz(3)
  notes             String?         @db.Text
  submittedAt       DateTime?       @map("submitted_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items           QuotationItem[]
  purchaseOrder   PurchaseOrder?  @relation("QuotationPurchaseOrder")

  @@unique([workspaceId, quotationNumber])
  @@unique([purchaseRequestId, vendorId])
  @@index([workspaceId, status])
  @@index([vendorId])
  @@map("quotations")
}

model QuotationItem {
  id                    String   @id @default(uuid()) @db.Uuid
  quotationId           String   @map("quotation_id") @db.Uuid
  purchaseRequestItemId String?  @map("purchase_request_item_id") @db.Uuid
  description           String   @db.VarChar(300)
  quantity              Decimal  @db.Decimal(12, 2)
  unit                  String   @default("unit") @db.VarChar(40)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal             Decimal  @map("line_total") @db.Decimal(14, 2)
  leadTimeDays          Int?     @map("lead_time_days")
  notes                 String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation           Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  purchaseRequestItem PurchaseRequestItem? @relation(fields: [purchaseRequestItemId], references: [id], onDelete: SetNull)

  @@unique([quotationId, purchaseRequestItemId])
  @@index([quotationId])
  @@index([purchaseRequestItemId])
  @@map("quotation_items")
}

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  workspaceId          String              @map("workspace_id") @db.Uuid
  poNumber             String              @map("po_number") @db.VarChar(40)
  purchaseRequestId    String?             @map("purchase_request_id") @db.Uuid
  vendorId             String              @map("vendor_id") @db.Uuid
  quotationId          String?             @unique @map("quotation_id") @db.Uuid
  status               PurchaseOrderStatus @default(draft)
  currency             Currency            @default(USD)
  subtotal             Decimal             @db.Decimal(14, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal             @map("total_amount") @db.Decimal(14, 2)
  issuedAt             DateTime?           @map("issued_at") @db.Timestamptz(3)
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Timestamptz(3)
  deliveredAt          DateTime?           @map("delivered_at") @db.Timestamptz(3)
  notes                String?             @db.Text
  createdById          String              @map("created_by_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  quotation       Quotation?          @relation("QuotationPurchaseOrder", fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  deliveries      Delivery[]

  @@unique([workspaceId, poNumber])
  @@index([workspaceId, status, issuedAt])
  @@index([vendorId])
  @@index([purchaseRequestId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  description      String   @db.VarChar(300)
  quantity         Decimal  @db.Decimal(12, 2)
  unit             String   @default("unit") @db.VarChar(40)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(14, 2)
  receivedQuantity Decimal  @default(0) @map("received_quantity") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  purchaseOrderId String         @map("purchase_order_id") @db.Uuid
  deliveryNumber  String         @map("delivery_number") @db.VarChar(40)
  status          DeliveryStatus @default(scheduled)
  carrier         String?        @db.VarChar(140)
  trackingNumber  String?        @map("tracking_number") @db.VarChar(100)
  scheduledAt     DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  deliveredAt     DateTime?      @map("delivered_at") @db.Timestamptz(3)
  receivedById    String?        @map("received_by_id") @db.Uuid
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy    User?         @relation("DeliveryReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, deliveryNumber])
  @@index([workspaceId, status, scheduledAt])
  @@index([purchaseOrderId])
  @@index([receivedById])
  @@map("deliveries")
}

/// Append-only by design: there is no updatedAt and no update path in the API.
/// A Phase 3 write service will only insert rows.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  summary     String?  @db.VarChar(500)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
